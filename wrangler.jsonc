{
  // Zone 210: static site in ./public plus a tiny Worker for /api/*
  "name": "zone210",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* goes through the Worker; everything else is served directly as static files.
    "run_worker_first": ["/api/*"],
    // An address that does not exist shows public/404.html (with a "not found" status) instead of a blank page.
    "not_found_handling": "404-page"
  }
}
